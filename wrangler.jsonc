{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "b",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "ai": {
    "binding": "AI",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "GITHUB_USERNAME": "pxnkit",
    "AI_MODE": "cloudflare",
    "AI_MODEL_PRIMARY": "@cf/zai-org/glm-4.7-flash",
    "AI_MODEL_ECONOMY": "@cf/ibm-granite/granite-4.0-h-micro",
    "AI_MODEL_CHALLENGER": "@cf/qwen/qwen3-30b-a3b-fp8",
    "ENABLE_ECONOMY_ROUTING": "false",
    "MAX_SESSION_GENERATED_ANSWERS": "8",
    "MAX_QUESTION_CHARACTERS": "700",
  },
  // Optional distributed counters:
  // "kv_namespaces": [
  //   {
  //     "binding": "RATE_LIMIT_KV",
  //     "id": "<RATE_LIMIT_KV_NAMESPACE_ID>"
  //   }
  // ]
}
