# Local development defaults. Copy this file to .env.local; never commit secrets.
CHAT_MOCK_MODE=true
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional abuse controls. Leave both Turnstile values empty to disable it locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
RATE_LIMIT_MAX_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60

# Optional public canonical URL used for metadata and origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
